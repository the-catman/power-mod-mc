{
	"schemaVersion": 1,
	"id": "powermod",
	"version": "${version}",
	"name": "Power Mod",
	"description": "Adds extremely powerful new items.",
	"authors": [
		"theca"
	],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.theca.powermod.PowerMod"
		],
		"client": [
			"com.theca.powermod.client.PowerModClient"
		]
	},
	"mixins": [
		"powermod.mixins.json",
